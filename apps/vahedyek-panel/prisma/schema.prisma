generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                               String                         @id @default(cuid())
  slug                             String                         @unique
  name                             String
  brandCode                        String                         @default("VN")
  createdAt                        DateTime                       @default(now())
  updatedAt                        DateTime                       @updatedAt
  packageKey                       String                         @default("starter")
  billingCycle                     String                         @default("monthly")
  projectUnitTypes                 Json                           @default("[]")
  projectReportData                Json                           @default("{}")
  projectTechnicalSpecs            Json                           @default("{}")
  projectAddressData               Json                           @default("{}")
  /// پیکربندی قدیمی مسیر تأیید (منسوخ — پس از مهاجرت Workflow حذف می‌شود)
  approvalProcessConfig            Json                           @default("{}")
  projectPhysicalProgressSchedules Json                           @default("[]")
  workflows                        ApprovalWorkflow[]
  auditLogs                        AuditLog[]
  blocks                           Block[]
  blockFloors                      BlockFloor[]
  appendices                       ContractAppendix[]
  drafts                           ContractDraft[]
  DevPageDocument                  DevPageDocument[]
  DevPageDocumentEvent             DevPageDocumentEvent[]
  DevPageDocumentReadState         DevPageDocumentReadState[]
  DevPageThreadReadState           DevPageThreadReadState[]
  directory                        DirectoryPerson[]
  representatives                  DirectoryRepresentative[]
  employees                        Employee[]
  formerEmployees                  FormerEmployee[]
  projectPlates                    ProjectPlate[]
  sessions                         Session[]
  TenantBusinessProfileSettings    TenantBusinessProfileSettings?
  contractRuleSettings             TenantContractRuleSettings?
  TenantReminderNotification       TenantReminderNotification[]
  reminderSettings                 TenantReminderSettings?
  roles                            TenantRole[]
  units                            Unit[]
  reminderActivities               UserReminderActivity[]
  reminderPageActivities           UserReminderPageActivity[]
  memberships                      UserTenantMembership[]
}

model AppUser {
  id                                                                             String                       @id @default(cuid())
  email                                                                          String?                      @unique
  fullName                                                                       String
  passwordHash                                                                   String
  passwordSalt                                                                   String
  createdAt                                                                      DateTime                     @default(now())
  updatedAt                                                                      DateTime                     @updatedAt
  mobile                                                                         String?                      @unique
  firstName                                                                      String?
  lastName                                                                       String?
  auditLogs                                                                      AuditLog[]
  contractAppendices                                                             ContractAppendix[]
  DevPageDocument_DevPageDocument_createdByIdToAppUser                           DevPageDocument[]            @relation("DevPageDocument_createdByIdToAppUser")
  DevPageDocument_DevPageDocument_updatedByIdToAppUser                           DevPageDocument[]            @relation("DevPageDocument_updatedByIdToAppUser")
  DevPageDocumentEvent                                                           DevPageDocumentEvent[]
  DevPageDocumentReadState                                                       DevPageDocumentReadState[]
  DevPageMessage                                                                 DevPageMessage[]
  DevPageThread_DevPageThread_createdByIdToAppUser                               DevPageThread[]              @relation("DevPageThread_createdByIdToAppUser")
  DevPageThread_DevPageThread_updatedByIdToAppUser                               DevPageThread[]              @relation("DevPageThread_updatedByIdToAppUser")
  DevPageThreadReadState                                                         DevPageThreadReadState[]
  representatives                                                                DirectoryRepresentative[]
  sessions                                                                       Session[]
  TenantReminderNotification_TenantReminderNotification_createdByUserIdToAppUser TenantReminderNotification[] @relation("TenantReminderNotification_createdByUserIdToAppUser")
  TenantReminderNotification_TenantReminderNotification_userIdToAppUser          TenantReminderNotification[] @relation("TenantReminderNotification_userIdToAppUser")
  reminderActivities                                                             UserReminderActivity[]
  reminderPageActivities                                                         UserReminderPageActivity[]
  memberships                                                                    UserTenantMembership[]
}

model TenantReminderSettings {
  id           String   @id
  tenantId     String   @unique
  settingsJson String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model UserReminderActivity {
  id                     String    @id
  tenantId               String
  userId                 String
  previousPath           String?
  lastPath               String    @default("/")
  lastSeenAt             DateTime  @default(now())
  lastInputAt            DateTime?
  lastReminderShownAt    DateTime?
  lastTourAcknowledgedAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now()) @updatedAt
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

model UserReminderPageActivity {
  id                     String    @id
  tenantId               String
  userId                 String
  pagePath               String
  pageTitle              String?
  firstVisitedAt         DateTime  @default(now())
  lastVisitedAt          DateTime  @default(now())
  lastInputAt            DateTime?
  inputCount             Int       @default(0)
  lastMeaningfulActionAt DateTime?
  meaningfulActionCount  Int       @default(0)
  lastActionSummary      String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now()) @updatedAt
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                   AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, pagePath])
  @@index([userId, lastVisitedAt(sort: Desc)])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String?
  actorName   String
  action      String
  entityType  String
  entityId    String?
  entityLabel String?
  summary     String
  details     Json     @default("{}")
  diff        Json     @default("[]")
  metadata    Json     @default("{}")
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actor       AppUser? @relation(fields: [actorUserId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([tenantId, entityType])
  @@index([tenantId, actorUserId])
}

model UserTenantMembership {
  id        String                     @id @default(cuid())
  userId    String
  tenantId  String
  role      String                     @default("member")
  createdAt DateTime                   @default(now())
  tenant    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      AppUser                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles     UserTenantMembershipRole[]

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

model TenantRole {
  id                    String                     @id @default(cuid())
  tenantId              String
  key                   String
  label                 String
  system                Boolean                    @default(false)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  tenant                Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  legacyMenuPermissions TenantRoleMenuPermission[]
  permissions           TenantRolePermission[]
  memberships           UserTenantMembershipRole[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model TenantRolePermission {
  id            String     @id @default(cuid())
  roleId        String
  permissionKey String
  createdAt     DateTime   @default(now())
  role          TenantRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionKey])
  @@index([roleId])
  @@index([permissionKey])
}

model UserTenantMembershipRole {
  id           String               @id @default(cuid())
  membershipId String
  roleId       String
  createdAt    DateTime             @default(now())
  membership   UserTenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         TenantRole           @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@index([membershipId])
  @@index([roleId])
}

model TenantRoleMenuPermission {
  id         String     @id @default(cuid())
  roleId     String
  menuItemId String
  createdAt  DateTime   @default(now())
  role       TenantRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, menuItemId])
  @@index([roleId])
  @@index([menuItemId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  tenantId  String?
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
}

model ContractDraft {
  id                          String                         @id @default(uuid())
  tenantId                    String
  createdAt                   DateTime                       @default(now())
  updatedAt                   DateTime                       @updatedAt
  /// پس از «عدم تأیید»، تا زمان پاک‌شدن، قرارداد در لیست پیش‌نویس می‌ماند حتی با تکمیل ظاهری مراحل.
  approvalReturnedPending     Boolean                        @default(false)
  approvalLastRejectionReason String?
  approvalLastRejectedAt      DateTime?
  /// پس از ویرایش قرارداد تأییدشده؛ نمونهٔ workflow حذف شده تا وضعیت «پیش‌نویس» شود تا ارسال مجدد به تأیید.
  releasedFromApprovedForEdit Boolean                        @default(false)
  appendices                  ContractAppendix[]
  approvalInstance            ContractApprovalInstance?
  attachments                 ContractAttachments?
  walletLedger                ContractCustomerWalletLedger[]
  tenant                      Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  extraCosts                  ContractExtraCosts?
  financial                   ContractFinancial?
  parties                     ContractParties?
  penalties                   ContractPenalties?
  receipts                    ContractReceipt[]
  subject                     ContractSubject?
  technicalSpecs              ContractTechnicalSpecs?
  terminationRules            TerminationRules?

  @@index([tenantId, updatedAt])
}

model ContractAppendix {
  id                          String                            @id @default(uuid())
  tenantId                    String
  draftId                     String
  previousAppendixId          String?
  sourceKind                  String                            @default("contract")
  sourceId                    String?
  status                      ContractAppendixStatus            @default(DRAFT)
  appendixNumber              Int
  title                       String
  summary                     String?
  effectiveDate               String
  issuerType                  String
  issuerName                  String
  notes                       String?
  approvalReturnedPending     Boolean                           @default(false)
  approvalLastRejectionReason String?
  approvalLastRejectedAt      DateTime?
  releasedFromApprovedForEdit Boolean                           @default(false)
  createdByUserId             String?
  createdAt                   DateTime                          @default(now())
  updatedAt                   DateTime                          @updatedAt
  createdByUser               AppUser?                          @relation(fields: [createdByUserId], references: [id])
  draft                       ContractDraft                     @relation(fields: [draftId], references: [id], onDelete: Cascade)
  previousAppendix            ContractAppendix?                 @relation("AppendixChain", fields: [previousAppendixId], references: [id])
  nextAppendices              ContractAppendix[]                @relation("AppendixChain")
  tenant                      Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvalInstance            ContractAppendixApprovalInstance?
  items                       ContractAppendixItem[]

  @@unique([draftId, appendixNumber])
  @@index([tenantId, draftId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([previousAppendixId])
}

model ContractAppendixItem {
  id          String           @id @default(cuid())
  appendixId  String
  tagKey      String
  groupKey    String
  title       String
  description String?
  payload     Json             @default("{}")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  appendix    ContractAppendix @relation(fields: [appendixId], references: [id], onDelete: Cascade)

  @@index([appendixId, groupKey])
  @@index([appendixId, tagKey])
}

model ContractAppendixApprovalInstance {
  id                      String                             @id @default(cuid())
  tenantId                String
  appendixId              String                             @unique
  workflowId              String
  status                  ContractApprovalInstanceStatus     @default(IN_REVIEW)
  currentStepIndex        Int                                @default(0)
  finalApproverUserId     String?
  stepsSnapshot           Json
  revisionResumeStepIndex Int?
  createdAt               DateTime                           @default(now())
  updatedAt               DateTime                           @updatedAt
  decisions               ContractAppendixApprovalDecision[]
  appendix                ContractAppendix                   @relation(fields: [appendixId], references: [id], onDelete: Cascade)
  workflow                ApprovalWorkflow                   @relation(fields: [workflowId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
}

model ContractAppendixApprovalDecision {
  id             String                           @id @default(cuid())
  instanceId     String
  stepId         String
  approverUserId String
  decision       ContractApprovalDecisionType
  reason         String?
  createdAt      DateTime                         @default(now())
  instance       ContractAppendixApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, stepId])
  @@index([approverUserId])
}

/// تعریف یک مسیر تأیید چندمرحله‌ای (Workflow Builder)
model ApprovalWorkflow {
  id                  String                             @id @default(cuid())
  tenantId            String
  title               String
  /// انواع کاربری واحد که این workflow روی آن‌ها اعمال می‌شود (مثلاً residential, commercial)
  usageTypes          String[]                           @default([])
  /// مراحل به‌صورت JSON — ساختار در `app/lib/workflowTypes.ts`
  steps               Json                               @default("[]")
  /// آیا پیش از ورود به سازمان، خریدار باید تأیید کند (رفتار legacy)
  buyerShouldApprove  Boolean                            @default(true)
  active              Boolean                            @default(true)
  createdAt           DateTime                           @default(now())
  updatedAt           DateTime                           @updatedAt
  /// تأییدکننده نهایی اختیاری برای کل فرایند؛ رأی این نفر فرایند را فوراً تمام می‌کند.
  finalApproverUserId String?
  tenant              Tenant                             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appendixInstances   ContractAppendixApprovalInstance[]
  instances           ContractApprovalInstance[]

  @@index([tenantId])
  @@index([tenantId, active])
  @@index([tenantId], map: "ApprovalWorkflow_tenantId_usageTypes_idx")
}

/// یک اجرای فعال/تکمیل‌شدهٔ workflow روی یک پیش‌نویس
model ContractApprovalInstance {
  id                      String                         @id @default(cuid())
  tenantId                String
  draftId                 String                         @unique
  workflowId              String
  status                  ContractApprovalInstanceStatus @default(IN_REVIEW)
  currentStepIndex        Int                            @default(0)
  /// کپی immutable از steps در لحظهٔ submit
  stepsSnapshot           Json
  /// پس از Request Revision: از این اندیس مرحله ادامه داده می‌شود
  revisionResumeStepIndex Int?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  /// snapshot از تأییدکننده نهایی workflow در لحظهٔ submit/resume
  finalApproverUserId     String?
  decisions               ContractApprovalDecision[]
  draft                   ContractDraft                  @relation(fields: [draftId], references: [id], onDelete: Cascade)
  workflow                ApprovalWorkflow               @relation(fields: [workflowId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
}

model ContractApprovalDecision {
  id             String                       @id @default(cuid())
  instanceId     String
  stepId         String
  approverUserId String
  decision       ContractApprovalDecisionType
  reason         String?
  createdAt      DateTime                     @default(now())
  instance       ContractApprovalInstance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, stepId])
  @@index([approverUserId])
}

/// قواعد فسخ ذخیره‌شده برای هر پیش‌نویس؛ خریدار به‌صورت JSONB در `buyerRules`.
model TerminationRules {
  id         String        @id @default(cuid())
  draftId    String        @unique
  buyerRules Json          @default("{}")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  draft      ContractDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
}

model ContractExtraCosts {
  id        String        @id @default(cuid())
  draftId   String        @unique
  payload   Json          @default("[]")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  draft     ContractDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
}

model ContractTechnicalSpecs {
  id        String        @id @default(cuid())
  draftId   String        @unique
  specs     Json          @default("[]")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  draft     ContractDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
}

model ContractAttachments {
  id        String        @id @default(cuid())
  draftId   String        @unique
  documents Json          @default("[]")
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  draft     ContractDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
}

model ContractSubject {
  id                   String         @id @default(cuid())
  draftId              String         @unique
  contractorType       ContractorType
  contractorEmployeeId String?
  contractorFormerName String?
  contractType         ContractType
  contractDate         String
  contractNumber       String
  deliveryDate         String
  blockId              String
  unitId               String
  block                Block          @relation(fields: [blockId], references: [id])
  contractorEmployee   Employee?      @relation(fields: [contractorEmployeeId], references: [id])
  draft                ContractDraft  @relation(fields: [draftId], references: [id], onDelete: Cascade)
  unit                 Unit           @relation(fields: [unitId], references: [id])

  @@index([contractNumber])
}

model ContractParties {
  id           String                @id @default(cuid())
  draftId      String                @unique
  partyOneMode ShareMode             @default(dang)
  partyTwoMode ShareMode             @default(dang)
  draft        ContractDraft         @relation(fields: [draftId], references: [id], onDelete: Cascade)
  members      ContractPartyMember[]
}

model ContractPartyMember {
  id          String           @id @default(cuid())
  partiesId   String
  side        PartySide
  personId    String
  directoryId String?
  personType  PersonType
  name        String
  shareValue  Decimal          @db.Decimal(18, 2)
  isPrimary   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  directory   DirectoryPerson? @relation(fields: [directoryId], references: [id])
  parties     ContractParties  @relation(fields: [partiesId], references: [id], onDelete: Cascade)

  @@index([partiesId, side])
}

model ContractFinancial {
  id                   String              @id @default(cuid())
  draftId              String              @unique
  pricingType          PricingType         @default(fixed)
  totalArea            Decimal?            @db.Decimal(18, 2)
  pricePerMeter        Decimal?            @db.Decimal(18, 2)
  fixedTotalAmount     Decimal?            @db.Decimal(18, 2)
  activeTab            String?
  unitArea             Decimal?            @db.Decimal(18, 2)
  parkingArea          Decimal?            @db.Decimal(18, 2)
  parkingPricePerMeter Decimal?            @db.Decimal(18, 2)
  areaPricingMode      String              @default("unit-only")
  storageArea          Decimal?            @db.Decimal(18, 2)
  storagePricePerMeter Decimal?            @db.Decimal(18, 2)
  parkingFixedAmount   Decimal?            @db.Decimal(18, 2)
  storageFixedAmount   Decimal?            @db.Decimal(18, 2)
  draft                ContractDraft       @relation(fields: [draftId], references: [id], onDelete: Cascade)
  categories           FinancialCategory[]
  dueItems             FinancialDueItem[]
}

model ContractPenalties {
  id      String                @id @default(cuid())
  draftId String                @unique
  draft   ContractDraft         @relation(fields: [draftId], references: [id], onDelete: Cascade)
  rules   ContractPenaltyRule[]
  types   ContractPenaltyType[]
}

model ContractPenaltyType {
  id          String                @id
  penaltiesId String
  title       String
  active      Boolean               @default(false)
  rules       ContractPenaltyRule[]
  penalties   ContractPenalties     @relation(fields: [penaltiesId], references: [id], onDelete: Cascade)

  @@index([penaltiesId])
}

model ContractPenaltyRule {
  id                  String              @id
  penaltiesId         String
  penaltyTypeId       String
  mode                String
  period              String
  fixedAmount         Decimal?            @db.Decimal(18, 2)
  penaltyPercent      Decimal?            @db.Decimal(18, 2)
  bankInterestPercent Decimal?            @db.Decimal(18, 2)
  graceDays           Int?
  roundRule           String?
  extraFeeEnabled     Boolean             @default(false)
  extraFeeType        String?
  extraFeeAmount      Decimal?            @db.Decimal(18, 2)
  extraFeeRoundRule   String?
  progressiveRows     Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  penalties           ContractPenalties   @relation(fields: [penaltiesId], references: [id], onDelete: Cascade)
  penaltyType         ContractPenaltyType @relation(fields: [penaltyTypeId], references: [id], onDelete: Cascade)

  @@index([penaltiesId, penaltyTypeId])
}

model FinancialCategory {
  id          String             @id
  financialId String
  name        String
  capAmount   Decimal            @db.Decimal(18, 2)
  dueAmount   Decimal            @db.Decimal(18, 2)
  noDueAmount Decimal            @db.Decimal(18, 2)
  system      Boolean            @default(false)
  requiresDue Boolean            @default(true)
  financial   ContractFinancial  @relation(fields: [financialId], references: [id], onDelete: Cascade)
  dueItems    FinancialDueItem[]

  @@index([financialId])
}

model FinancialDueItem {
  id          String            @id
  financialId String
  categoryId  String
  amount      Decimal           @db.Decimal(18, 2)
  dueDate     String
  title       String            @default("")
  category    FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  financial   ContractFinancial @relation(fields: [financialId], references: [id], onDelete: Cascade)

  @@index([financialId, categoryId])
}

model ContractReceipt {
  id                 String                         @id @default(cuid())
  tenantId           String
  draftId            String
  allocationMode     String
  allocationDate     String
  transferKind       String
  depositorName      String
  paidAmountRial     Decimal                        @db.Decimal(18, 2)
  depositDate        String
  depositTime        String?
  destinationValue   String?
  destinationHolder  String?
  destinationHolders Json                           @default("[]")
  trackingNumber     String?
  referenceNumber    String?
  receiptNumber      String?
  notes              String?
  documents          Json                           @default("[]")
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  walletLedger       ContractCustomerWalletLedger[]
  draft              ContractDraft                  @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([tenantId, draftId])
  @@index([draftId, allocationDate])
}

model ContractCustomerWalletLedger {
  id         String           @id @default(cuid())
  tenantId   String
  draftId    String
  receiptId  String?
  amountRial Decimal          @db.Decimal(18, 2)
  reason     String           @default("overpayment")
  createdAt  DateTime         @default(now())
  draft      ContractDraft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  receipt    ContractReceipt? @relation(fields: [receiptId], references: [id])

  @@index([tenantId, draftId])
  @@index([receiptId])
}

model Employee {
  id           String            @id
  tenantId     String
  firstName    String
  lastName     String
  isActive     Boolean           @default(true)
  nationalCode String?
  subjects     ContractSubject[]
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, nationalCode])
  @@index([tenantId])
}

model FormerEmployee {
  id             String   @id @default(uuid())
  tenantId       String
  fullName       String
  normalizedName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, normalizedName])
  @@index([tenantId, fullName])
}

model Block {
  id          String            @id
  tenantId    String
  name        String
  mainPlate   String?
  subPlate    String?
  status      String            @default("incomplete")
  usageCounts Json              @default("{\"office\": 0, \"amenity\": 0, \"parking\": 0, \"storage\": 0, \"commercial\": 0, \"residential\": 0}")
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  floors      BlockFloor[]
  subjects    ContractSubject[]
  units       Unit[]

  @@index([tenantId])
}

model BlockFloor {
  id        String   @id
  tenantId  String
  blockId   String
  name      String
  createdAt DateTime @default(now())
  block     Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, blockId, name])
  @@index([tenantId, blockId])
}

model ProjectPlate {
  id        String   @id
  tenantId  String
  mainPlate String
  subPlates Json     @default("[]")
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, mainPlate])
  @@index([tenantId])
}

model Unit {
  id               String            @id
  tenantId         String
  blockId          String
  floorName        String
  name             String
  category         String            @default("unit")
  unitType         String?
  usage            String            @default("residential")
  saleEnabled      Boolean           @default(true)
  deliveryStatus   String            @default("ready")
  area             Float?
  balconyCount     Int               @default(0)
  bedroomCount     Int               @default(0)
  postalCode       String?
  amenities        Json              @default("[]")
  direction        String            @default("unknown")
  assignedToUnitId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  baseInfo         String?
  areaPricingMode  String            @default("unit-only")
  subjects         ContractSubject[]
  block            Block             @relation(fields: [blockId], references: [id], onDelete: Cascade)
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, blockId])
  @@index([tenantId, blockId, category])
  @@index([tenantId, assignedToUnitId])
}

model DirectoryPerson {
  id              String                    @id
  tenantId        String
  name            String
  role            DirectoryRole
  personType      PersonType
  parties         ContractPartyMember[]
  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  representatives DirectoryRepresentative[]

  @@index([tenantId, role, personType])
}

model DirectoryRepresentative {
  id                  String                      @id @default(cuid())
  tenantId            String
  principalId         String
  userId              String?
  principalType       RepresentativePrincipalType
  fullName            String
  email               String?
  hasSigningAuthority Boolean                     @default(false)
  panelAccessEnabled  Boolean                     @default(false)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  principal           DirectoryPerson             @relation(fields: [principalId], references: [id], onDelete: Cascade)
  tenant              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                AppUser?                    @relation(fields: [userId], references: [id])

  @@index([tenantId, principalType])
  @@index([principalId])
  @@index([userId])
}

model TenantContractRuleSettings {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  rulesPayload Json     @default("{}")
  loanPayload  Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model DevPageDocument {
  id                                           String   @id
  tenantId                                     String
  pagePath                                     String
  pageKey                                      String
  title                                        String
  docType                                      String   @default("free")
  contentHtml                                  String   @default("")
  createdById                                  String
  updatedById                                  String
  createdAt                                    DateTime @default(now())
  updatedAt                                    DateTime @default(now())
  appId                                        String   @default("vahedyek")
  audioDataUrl                                 String?
  audioMimeType                                String?
  labelsJson                                   String   @default("[]")
  AppUser_DevPageDocument_createdByIdToAppUser AppUser  @relation("DevPageDocument_createdByIdToAppUser", fields: [createdById], references: [id])
  Tenant                                       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  AppUser_DevPageDocument_updatedByIdToAppUser AppUser  @relation("DevPageDocument_updatedByIdToAppUser", fields: [updatedById], references: [id])

  @@index([tenantId, appId, pageKey])
  @@index([tenantId, appId, updatedAt(sort: Desc)])
  @@index([tenantId, pageKey])
  @@index([tenantId, updatedAt(sort: Desc)])
}

model DevPageDocumentEvent {
  id          String   @id
  tenantId    String
  appId       String   @default("vahedyek")
  pagePath    String
  pageKey     String
  docId       String?
  docTitle    String?
  eventType   String
  details     String?
  actorUserId String
  createdAt   DateTime @default(now())
  docType     String?
  labelsJson  String   @default("[]")
  AppUser     AppUser  @relation(fields: [actorUserId], references: [id])
  Tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, appId, createdAt(sort: Desc)])
}

model DevPageDocumentReadState {
  id         String   @id
  tenantId   String
  appId      String   @default("vahedyek")
  userId     String
  documentId String
  isRead     Boolean  @default(false)
  updatedAt  DateTime @default(now())
  Tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  AppUser    AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, appId, userId, documentId])
}

model DevPageMessage {
  id                 String        @id
  threadId           String
  authorUserId       String
  replyToMessageId   String?
  messageType        String        @default("text")
  text               String?
  attachmentDataUrl  String?
  attachmentMimeType String?
  attachmentName     String?
  attachmentSize     Int?
  createdAt          DateTime      @default(now())
  AppUser            AppUser       @relation(fields: [authorUserId], references: [id])
  DevPageThread      DevPageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model DevPageThread {
  id                                         String                   @id
  appId                                      String                   @default("vahedyek")
  pageKey                                    String
  pagePathSample                             String                   @default("/")
  title                                      String
  docType                                    String                   @default("free")
  priority                                   String                   @default("p2")
  labelsJson                                 String                   @default("[]")
  createdById                                String
  updatedById                                String
  createdAt                                  DateTime                 @default(now())
  updatedAt                                  DateTime                 @default(now())
  status                                     String                   @default("todo")
  DevPageMessage                             DevPageMessage[]
  AppUser_DevPageThread_createdByIdToAppUser AppUser                  @relation("DevPageThread_createdByIdToAppUser", fields: [createdById], references: [id])
  AppUser_DevPageThread_updatedByIdToAppUser AppUser                  @relation("DevPageThread_updatedByIdToAppUser", fields: [updatedById], references: [id])
  DevPageThreadReadState                     DevPageThreadReadState[]

  @@index([appId, pageKey])
  @@index([appId, updatedAt(sort: Desc)])
}

model DevPageThreadReadState {
  id        String        @id
  tenantId  String
  appId     String        @default("vahedyek")
  userId    String
  threadId  String
  isOpened  Boolean       @default(false)
  updatedAt DateTime      @default(now())
  Tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Thread    DevPageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  AppUser   AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, appId, userId, threadId])
}

model TenantBusinessProfileSettings {
  id             String   @id
  tenantId       String   @unique
  profilePayload Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
  Tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model TenantReminderNotification {
  id                                                          String    @id
  tenantId                                                    String
  userId                                                      String
  createdByUserId                                             String
  title                                                       String
  messageText                                                 String
  targetEmail                                                 String?
  emailStatus                                                 String    @default("missing")
  pushStatus                                                  String    @default("queued")
  acknowledgedAt                                              DateTime?
  createdAt                                                   DateTime  @default(now())
  updatedAt                                                   DateTime  @default(now())
  AppUser_TenantReminderNotification_createdByUserIdToAppUser AppUser   @relation("TenantReminderNotification_createdByUserIdToAppUser", fields: [createdByUserId], references: [id], onDelete: Cascade)
  Tenant                                                      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  AppUser_TenantReminderNotification_userIdToAppUser          AppUser   @relation("TenantReminderNotification_userIdToAppUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, acknowledgedAt, createdAt(sort: Desc)], map: "TenantReminderNotification_tenantId_userId_ack_idx")
}

