generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model AppUser {
  id                  String                     @id @default(cuid())
  email               String?                    @unique
  mobile              String?                    @unique
  firstName           String
  lastName            String
  fullName            String
  passwordHash        String
  passwordSalt        String
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  memberships         UserTenantMembership[]
  setupReminderStates TenantSetupReminderState[]
}

model Tenant {
  id                         String                          @id @default(cuid())
  slug                       String                          @unique
  name                       String
  brandCode                  String                          @default("DS")
  packageKey                 String                          @default("starter")
  billingCycle               String                          @default("monthly")
  createdAt                  DateTime                        @default(now())
  updatedAt                  DateTime                        @updatedAt
  memberships                UserTenantMembership[]
  roles                      TenantRole[]
  businessProfiles           BusinessProfile[]
  locations                  Location[]
  calendars                  Calendar[]
  policies                   WorkPolicy[]
  employees                  Employee[]
  employeeImportJobs         EmployeeImportJob[]
  workGroups                 WorkGroup[]
  workGroupAudits            WorkGroupAuditLog[]
  workGroupContextHistory    WorkGroupContextHistory[]
  organizationUnits          OrganizationUnit[]
  jobProfiles                JobProfile[]
  organizationTemplates      OrganizationStructureTemplate[]
  requestReasons             RequestReason[]
  shiftTemplates             ShiftTemplate[]
  draftTemplates             DraftTemplate[]
  clientStorageStates        ClientStorageState[]
  businessProfileSettings    TenantBusinessProfileSettings[]
  employeeRequests           EmployeeRequest[]
  employeeContracts          EmployeeContract[]
  employeeAuditLogs          EmployeeAuditLog[]
  organizationEvents         OrganizationEvent[]
  organizationRoadmaps       OrganizationRoadmap[]
  jobFamilies                JobFamily[]
  jobCategories              JobCategory[]
  jobLevels                  JobLevel[]
  jobClassifications         JobClassification[]
  jobEvaluationCriteria      JobEvaluationCriterion[]
  jobEvaluations             JobEvaluation[]
  jobGrades                  JobGrade[]
  jobRanks                   JobRank[]
  jobCompensationRanges      JobCompensationRange[]
  employeeTerminationIntents EmployeeTerminationIntent[]
  employeeSkills             EmployeeSkill[]
  employeeInterests          EmployeeInterest[]
  employeePreferences        EmployeeWorkPreference[]
  employeeHealthProfiles     EmployeeHealthProfile[]
  employeeEmergencyContacts  EmployeeEmergencyContact[]
  employeeProfileApprovals   EmployeeProfileApproval[]
  employeeChangeRequests     EmployeeChangeRequest[]
  companyLoans               CompanyLoan[]
  attachments                Attachment[]
  employeeDocuments          EmployeeDocument[]
  employeeAssessments        EmployeeAssessment[]
  employeeFinancialItems     EmployeeFinancialItem[]
  employeeDamages             EmployeeDamage[]
  employeeAssessmentAuditLogs EmployeeAssessmentAuditLog[]
  setupReminderStates        TenantSetupReminderState[]
}

enum OrganizationUnitStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PositionStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrganizationRoadmapStatus {
  PLANNED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum OrganizationTemplateStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrganizationAssignmentStatus {
  ACTIVE
  ENDED
  FUTURE
}

model UserTenantMembership {
  id        String                     @id @default(cuid())
  userId    String
  tenantId  String
  role      String                     @default("member")
  createdAt DateTime                   @default(now())
  user      AppUser                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles     UserTenantMembershipRole[]
  employee  Employee?

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

model TenantRole {
  id          String                     @id @default(cuid())
  tenantId    String
  key         String
  label       String
  system      Boolean                    @default(false)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships UserTenantMembershipRole[]
  permissions TenantRolePermission[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model TenantRolePermission {
  id            String     @id @default(cuid())
  roleId        String
  permissionKey String
  createdAt     DateTime   @default(now())
  role          TenantRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionKey])
  @@index([roleId])
}

model UserTenantMembershipRole {
  id           String               @id @default(cuid())
  membershipId String
  roleId       String
  createdAt    DateTime             @default(now())
  membership   UserTenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         TenantRole           @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@index([membershipId])
  @@index([roleId])
}

// ─── HR Enums ─────────────────────────────────────────────────────────────────

enum QuickSetupStatus {
  pending
  in_progress
  completed
}

enum ShiftTemplateType {
  fixed
  floating_day_start
  floating_absolute
  split
  rotate
}

enum RequestReasonCategory {
  daily_leave
  hourly_leave
  reward_leave
  unpaid_leave
  sick_leave
  overtime
  attendance
  remote_work
  mission
  salary_advance
  loan
}

enum EmployeeRequestType {
  daily_leave
  hourly_leave
  reward_leave
  unpaid_leave
  sick_leave
  overtime
  attendance
  remote_work
  mission
  salary_advance
  loan
}

enum EmployeeContractStatus {
  draft
  DRAFT
  active
  ended
  canceled
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  EXPIRED
  SUSPENDED
  TERMINATED
  CANCELLED
}

enum EmployeeContractOperationType {
  CREATE_CONTRACT
  RENEW_CONTRACT
  AMEND_CONTRACT
  TERMINATE_CONTRACT
}

enum EmployeeContractApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmployeeDocumentSourceType {
  DIRECT_UPLOAD
  MODULE_GENERATED
}

enum EmployeeDocumentSourceModule {
  CONTRACT
  PAYROLL
  REQUEST
  TERMINATION
  OTHER
}

enum EmployeeDocumentStatus {
  DRAFT
  PENDING_APPROVAL
  FINAL
  REJECTED
  EXPIRED
  REPLACED
  ARCHIVED
  VOID
}

enum EmployeeDocumentAccessLevel {
  PRIVATE
  EMPLOYEE
  MANAGERS
  HR
  FINANCIAL
}

enum EmployeeProfileApprovalStatus {
  NOT_STARTED
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum EmployeeChangeRequestStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  APPLIED
  CANCELLED
}

enum EmployeeRequestStatus {
  pending
  approved
  rejected
  canceled
}

enum EmployeeImportJobType {
  excel_add
  excel_add_and_invite
}

enum EmployeeImportJobStatus {
  queued
  processing
  completed
  completed_with_errors
  failed
}

enum EmployeeImportJobRowStatus {
  created
  existing_employee
  duplicate_in_file
  invalid
  failed
  mock_invited
  mock_invite_failed
}

enum EmployeeImportJobMockInvitationStatus {
  none
  mock_sent
  mock_failed
  not_required
}

enum EmployeeImportJobInvitationChannel {
  sms
  email
}

enum EmployeeRequestSubmissionMode {
  approved
  pending
}

enum EmployeeRequestRangeType {
  full_day
  multi_day
  hourly
  range
  point
}

enum AttendanceActionType {
  check_in
  check_out
  correction
}

enum MaritalStatus {
  single
  married
  divorced
}

enum CalendarStatus {
  active
  inactive
}

enum DraftTemplateCategory {
  payroll
  attendance
  hr
}

enum WorkGroupAccessLevel {
  employee
  lead
  manager
}

enum WorkGroupLifecycleStatus {
  ACTIVE
  INACTIVE
}

enum WorkGroupMembershipStatus {
  ACTIVE
  ENDED
  FUTURE
}

enum WorkGroupContextType {
  POLICY
  LOCATION
}

// ─── HR Models ────────────────────────────────────────────────────────────────

model BusinessProfile {
  id                    String           @id @default(cuid())
  tenantId              String?
  brandName             String
  legalName             String?
  contactEmail          String?
  phone                 String?
  address               String?
  payrollPackageEnabled Boolean          @default(false)
  quickSetupStatus      QuickSetupStatus @default(pending)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  tenant                Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Location {
  id                  String      @id @default(cuid())
  tenantId            String?
  title               String
  address             String
  radius              Int
  latitude            Decimal?    @db.Decimal(10, 6)
  longitude           Decimal?    @db.Decimal(10, 6)
  description         String?
  isActive            Boolean     @default(true)
  isPrimaryOnboarding Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  tenant              Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workGroups          WorkGroup[]

  @@index([tenantId, isPrimaryOnboarding])
}

model OrganizationUnit {
  id                   String                     @id @default(cuid())
  tenantId             String?
  title                String
  code                 String?
  type                 String                     @default("DEPARTMENT")
  status               OrganizationUnitStatus     @default(ACTIVE)
  parentId             String?
  managerId            String?
  description          String?
  mission              String?
  mainResponsibilities Json                       @default("[]")
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  tenant               Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent               OrganizationUnit?          @relation("OrganizationUnitHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children             OrganizationUnit[]         @relation("OrganizationUnitHierarchy")
  manager              Employee?                  @relation("OrganizationUnitManager", fields: [managerId], references: [id], onDelete: SetNull)
  positions            Position[]
  employees            EmployeeOrganizationUnit[]
  historyEvents        OrganizationEvent[]        @relation("OrganizationUnitEvents")
  roadmapItems         OrganizationRoadmap[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([parentId])
  @@index([managerId])
}

model Position {
  id                  String                     @id @default(cuid())
  organizationUnitId  String
  title               String
  code                String?
  capacity            Int                        @default(1)
  status              PositionStatus             @default(ACTIVE)
  description         String?
  jobProfileId        String?
  reportsToPositionId String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  organizationUnit    OrganizationUnit           @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)
  jobProfile          JobProfile?                @relation(fields: [jobProfileId], references: [id], onDelete: SetNull)
  reportsToPosition   Position?                  @relation("PositionReportingLine", fields: [reportsToPositionId], references: [id], onDelete: SetNull)
  directReports       Position[]                 @relation("PositionReportingLine")
  assignments         EmployeeOrganizationUnit[]
  historyEvents       OrganizationEvent[]        @relation("PositionEvents")

  @@unique([organizationUnitId, code])
  @@index([organizationUnitId, status])
  @@index([jobProfileId])
  @@index([reportsToPositionId])
}

/// Immutable business events for the organizational timeline. This is a
/// minimal extension of the existing audit approach, not a parallel data owner.
model OrganizationEvent {
  id                 String            @id @default(cuid())
  tenantId           String
  organizationUnitId String?
  positionId         String?
  entityType         String
  eventType          String
  description        String
  occurredAt         DateTime          @default(now())
  effectiveAt        DateTime?
  previousValue      Json?
  newValue           Json?
  actorUserId        String?
  actorRole          String?
  reason             String?
  referenceType      String?
  referenceId        String?
  documentId         String?
  createdAt          DateTime          @default(now())
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organizationUnit   OrganizationUnit? @relation("OrganizationUnitEvents", fields: [organizationUnitId], references: [id], onDelete: Restrict)
  position           Position?         @relation("PositionEvents", fields: [positionId], references: [id], onDelete: Restrict)

  @@index([tenantId, organizationUnitId, occurredAt])
  @@index([tenantId, positionId, occurredAt])
  @@index([tenantId, eventType, occurredAt])
  @@index([tenantId, actorUserId, occurredAt])
}

model OrganizationRoadmap {
  id                 String                    @id @default(cuid())
  tenantId           String
  organizationUnitId String?
  title              String
  description        String?
  targetDate         DateTime
  status             OrganizationRoadmapStatus @default(PLANNED)
  createdBy          String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organizationUnit   OrganizationUnit?         @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)

  @@index([tenantId, targetDate])
  @@index([tenantId, organizationUnitId, status])
}

model JobProfile {
  id                        String              @id @default(cuid())
  tenantId                  String
  title                     String
  code                      String?
  purpose                   String?
  summary                   String?
  status                    PositionStatus      @default(ACTIVE)
  revision                  Int                 @default(1)
  mainTasks                 Json                @default("[]")
  periodicTasks             Json                @default("[]")
  reportingResponsibilities Json                @default("[]")
  expectedOutputs           Json                @default("[]")
  internalRelations         Json                @default("[]")
  externalRelations         Json                @default("[]")
  suggestedKpis             Json                @default("[]")
  suggestedWorkLocation     String?
  workEnvironment           String?
  considerations            String?
  minimumEducation          String?
  relatedFields             Json                @default("[]")
  minimumExperienceMonths   Int?
  experienceLevel           String?
  technicalSkills           Json                @default("[]")
  softSkills                Json                @default("[]")
  certifications            Json                @default("[]")
  requiredSoftware          Json                @default("[]")
  languages                 Json                @default("[]")
  travelRequired            Boolean?
  workplaceConditions       String?
  specialRequirements       String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  tenant                    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  positions                 Position[]
  classifications           JobClassification[]
  evaluations               JobEvaluation[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model JobFamily {
  id              String              @id @default(cuid())
  tenantId        String
  name            String
  code            String
  description     String?
  status          PositionStatus      @default(ACTIVE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categories      JobCategory[]
  classifications JobClassification[]

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@index([tenantId, status])
}

model JobCategory {
  id              String              @id @default(cuid())
  tenantId        String
  familyId        String
  name            String
  code            String
  status          PositionStatus      @default(ACTIVE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  family          JobFamily           @relation(fields: [familyId], references: [id], onDelete: Restrict)
  classifications JobClassification[]

  @@unique([tenantId, code])
  @@unique([familyId, name])
  @@index([tenantId, familyId, status])
}

model JobLevel {
  id                   String              @id @default(cuid())
  tenantId             String
  name                 String
  code                 String
  sortOrder            Int
  status               PositionStatus      @default(ACTIVE)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classifications      JobClassification[]
  suggestedEvaluations JobEvaluation[]     @relation("SuggestedJobLevel")

  @@unique([tenantId, code])
  @@unique([tenantId, sortOrder])
  @@index([tenantId, status])
}

model JobClassification {
  id                 String                 @id @default(cuid())
  tenantId           String
  jobProfileId       String
  jobProfileRevision Int?
  familyId           String
  categoryId         String?
  levelId            String
  gradeId            String?
  rankId             String?
  status             PositionStatus         @default(ACTIVE)
  effectiveDate      DateTime
  version            Int
  createdBy          String?
  reason             String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobProfile         JobProfile             @relation(fields: [jobProfileId], references: [id], onDelete: Restrict)
  family             JobFamily              @relation(fields: [familyId], references: [id], onDelete: Restrict)
  category           JobCategory?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  level              JobLevel               @relation(fields: [levelId], references: [id], onDelete: Restrict)
  grade              JobGrade?              @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  rank               JobRank?               @relation(fields: [rankId], references: [id], onDelete: Restrict)
  evaluations        JobEvaluation[]
  compensationRanges JobCompensationRange[]

  @@unique([jobProfileId, version])
  @@index([tenantId, jobProfileId, status, effectiveDate])
}

model JobEvaluationCriterion {
  id          String              @id @default(cuid())
  tenantId    String
  title       String
  description String?
  weight      Int
  maxScore    Int                 @default(100)
  status      PositionStatus      @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items       JobEvaluationItem[]

  @@unique([tenantId, title])
}

model JobEvaluation {
  id               String                      @id @default(cuid())
  tenantId         String
  jobProfileId     String
  classificationId String?
  score            Int?
  totalScore       Decimal?                    @db.Decimal(7, 2)
  evaluationLevel  String?
  status           PositionStatus              @default(ACTIVE)
  evaluatorUserId  String?
  reason           String?
  effectiveAt      DateTime?
  suggestedLevelId String?
  suggestedGradeId String?
  suggestedRankId  String?
  approvedBy       String?
  approvedAt       DateTime?
  workflowState    JobEvaluationWorkflowState?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  tenant           Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobProfile       JobProfile                  @relation(fields: [jobProfileId], references: [id], onDelete: Restrict)
  classification   JobClassification?          @relation(fields: [classificationId], references: [id], onDelete: Restrict)
  suggestedLevel   JobLevel?                   @relation("SuggestedJobLevel", fields: [suggestedLevelId], references: [id], onDelete: Restrict)
  suggestedGrade   JobGrade?                   @relation("SuggestedJobGrade", fields: [suggestedGradeId], references: [id], onDelete: Restrict)
  suggestedRank    JobRank?                    @relation("SuggestedJobRank", fields: [suggestedRankId], references: [id], onDelete: Restrict)
  items            JobEvaluationItem[]

  @@index([tenantId, jobProfileId, status])
  @@index([tenantId, classificationId, createdAt])
  @@index([tenantId, workflowState, effectiveAt])
}

enum JobEvaluationWorkflowState {
  CREATED
  SCORED
  APPROVED
  REJECTED
}

model JobEvaluationItem {
  id           String                 @id @default(cuid())
  evaluationId String
  criterionId  String
  weight       Int
  maxScore     Int
  score        Decimal                @db.Decimal(7, 2)
  description  String?
  evidence     String
  evaluation   JobEvaluation          @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion    JobEvaluationCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@unique([evaluationId, criterionId])
  @@index([criterionId])
}

model JobGrade {
  id                   String                 @id @default(cuid())
  tenantId             String
  code                 String
  name                 String
  description          String?
  status               PositionStatus         @default(ACTIVE)
  sortOrder            Int
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ranks                JobRank[]
  classifications      JobClassification[]
  suggestedEvaluations JobEvaluation[]        @relation("SuggestedJobGrade")
  compensationRanges   JobCompensationRange[]

  @@unique([tenantId, code])
  @@unique([tenantId, sortOrder])
  @@index([tenantId, status])
}

model JobRank {
  id                   String              @id @default(cuid())
  tenantId             String
  gradeId              String
  code                 String
  name                 String
  description          String?
  status               PositionStatus      @default(ACTIVE)
  sortOrder            Int
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grade                JobGrade            @relation(fields: [gradeId], references: [id], onDelete: Restrict)
  classifications      JobClassification[]
  suggestedEvaluations JobEvaluation[]     @relation("SuggestedJobRank")

  @@unique([tenantId, code])
  @@unique([gradeId, sortOrder])
  @@index([tenantId, gradeId, status])
}

model JobCompensationRange {
  id               String            @id @default(cuid())
  tenantId         String
  classificationId String
  version          Int?
  gradeId          String
  minimumAmount    Decimal           @db.Decimal(18, 2)
  maximumAmount    Decimal           @db.Decimal(18, 2)
  currency         String            @default("IRR")
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  status           PositionStatus    @default(ACTIVE)
  reason           String
  createdBy        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classification   JobClassification @relation(fields: [classificationId], references: [id], onDelete: Restrict)
  grade            JobGrade          @relation(fields: [gradeId], references: [id], onDelete: Restrict)

  @@unique([classificationId, version])
  @@index([tenantId, classificationId, status, effectiveFrom])
  @@index([tenantId, gradeId, status])
}

model OrganizationStructureTemplate {
  id          String                              @id @default(cuid())
  tenantId    String
  name        String
  description String?
  status      OrganizationTemplateStatus          @default(INACTIVE)
  version     Int                                 @default(1)
  createdAt   DateTime                            @default(now())
  updatedAt   DateTime                            @updatedAt
  tenant      Tenant                              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units       OrganizationStructureTemplateUnit[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
}

model OrganizationStructureTemplateUnit {
  id                   String                                  @id @default(cuid())
  templateId           String
  parentTemplateUnitId String?
  name                 String
  type                 String                                  @default("DEPARTMENT")
  description          String?
  displayOrder         Int                                     @default(0)
  status               OrganizationUnitStatus                  @default(ACTIVE)
  template             OrganizationStructureTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parent               OrganizationStructureTemplateUnit?      @relation("OrganizationTemplateUnitHierarchy", fields: [parentTemplateUnitId], references: [id], onDelete: Restrict)
  children             OrganizationStructureTemplateUnit[]     @relation("OrganizationTemplateUnitHierarchy")
  positions            OrganizationStructureTemplatePosition[]

  @@index([templateId, displayOrder])
  @@index([parentTemplateUnitId])
}

model OrganizationStructureTemplatePosition {
  id             String                            @id @default(cuid())
  templateUnitId String
  title          String
  code           String?
  capacity       Int                               @default(1)
  status         PositionStatus                    @default(ACTIVE)
  displayOrder   Int                               @default(0)
  templateUnit   OrganizationStructureTemplateUnit @relation(fields: [templateUnitId], references: [id], onDelete: Cascade)

  @@unique([templateUnitId, code])
  @@index([templateUnitId, displayOrder])
}

model RequestReason {
  id               String                @id @default(cuid())
  tenantId         String?
  title            String
  description      String?
  category         RequestReasonCategory
  isActive         Boolean               @default(true)
  displayOrder     Int                   @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  tenant           Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeRequests EmployeeRequest[]

  @@index([tenantId])
}

model ShiftTemplate {
  id          String            @id @default(cuid())
  tenantId    String?
  title       String
  description String?
  type        ShiftTemplateType
  weekDays    Json              @default("[]")
  config      Json              @default("{}")
  breaks      Json              @default("[]")
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tenant      Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Calendar {
  id             String         @id @default(cuid())
  tenantId       String?
  title          String
  description    String?
  yearLabel      String
  startDate      String
  endDate        String
  weekends       Json           @default("[]")
  singleHolidays Json           @default("[]")
  status         CalendarStatus @default(active)
  shiftTitle     String         @default("")
  shiftTypeLabel String         @default("")
  shiftConfig    Json           @default("{}")
  holidayCount   Int            @default(0)
  totalShiftDays Int            @default(0)
  totalEventDays Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenant         Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policies       WorkPolicy[]
}

model WorkPolicy {
  id            String      @id @default(cuid())
  tenantId      String?
  title         String
  description   String?
  calendarId    String?
  sectionValues Json        @default("{}")
  employeeCount Int         @default(0)
  isDefault     Boolean     @default(false)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  tenant        Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calendar      Calendar?   @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  workGroups    WorkGroup[]
}

model Employee {
  id                         String                      @id @default(cuid())
  tenantId                   String?
  userTenantMembershipId     String?
  firstName                  String
  lastName                   String
  nationalId                 String?
  mobile1                    String?
  mobile2                    String?
  email                      String?
  personnelCode              String?
  maritalStatus              MaritalStatus               @default(single)
  childrenCount              Int                         @default(0)
  canEditIdentityPhoto       Boolean                     @default(false)
  isActive                   Boolean                     @default(true)
  avatarUrl                  String?
  identityPhotoUrl           String?
  bankAccounts               Json                        @default("[]")
  guarantees                 Json                        @default("[]")
  quickSetupStatus           String?
  quickSetupAddMethod        String?
  quickSetupInvitationStatus String?
  quickSetupLastActionAt     DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  tenant                     Tenant?                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userTenantMembership       UserTenantMembership?       @relation(fields: [userTenantMembershipId], references: [id], onDelete: SetNull)
  organizationUnits          EmployeeOrganizationUnit[]
  managedOrganizationUnits   OrganizationUnit[]          @relation("OrganizationUnitManager")
  workGroupMemberships       WorkGroupMember[]
  requests                   EmployeeRequest[]
  contracts                  EmployeeContract[]
  auditLogs                  EmployeeAuditLog[]
  terminationIntents         EmployeeTerminationIntent[]
  skills                     EmployeeSkill[]
  interests                  EmployeeInterest[]
  workPreference             EmployeeWorkPreference?
  healthProfile              EmployeeHealthProfile?
  emergencyContacts          EmployeeEmergencyContact[]
  profileApprovals           EmployeeProfileApproval[]
  changeRequests             EmployeeChangeRequest[]
  documents                  EmployeeDocument[]
  assessments                EmployeeAssessment[]
  financialItems             EmployeeFinancialItem[]
  damages                    EmployeeDamage[]
  damageObjections           EmployeeDamageObjection[]

  @@unique([tenantId, personnelCode])
  @@unique([userTenantMembershipId])
}

enum EmployeeDamageStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  APPLIED
  CLOSED
}
enum EmployeeDamageObjectionStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CLOSED
}
model EmployeeDamage {
  id String @id @default(cuid())
  tenantId String
  employeeId String
  title String
  description String
  amount Decimal @db.Decimal(18,2)
  incidentDate DateTime
  effectiveDate DateTime
  status EmployeeDamageStatus @default(DRAFT)
  documentReference String?
  createdBy String?
  approvedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  employee Employee @relation(fields:[employeeId], references:[id], onDelete:Cascade)
  objections EmployeeDamageObjection[]
  @@index([tenantId, employeeId, status])
}
model EmployeeDamageObjection {
  id String @id @default(cuid())
  damageId String
  employeeId String
  description String
  documents String?
  status EmployeeDamageObjectionStatus @default(SUBMITTED)
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedBy String?
  damage EmployeeDamage @relation(fields:[damageId], references:[id], onDelete:Restrict)
  employee Employee @relation(fields:[employeeId], references:[id], onDelete:Cascade)
  @@index([employeeId, status])
}

enum EmployeeFinancialItemType {
  PAYMENT
  BONUS
  ALLOWANCE
  MISSION_PAYMENT
  WELFARE_PAYMENT
  MEDICAL_SUPPORT
  OTHER_PAYMENT
  DEDUCTION
  LOAN
  ADVANCE
  DAMAGE
  FINE
  OTHER_DEDUCTION
}
enum EmployeeFinancialApplyMethod {
  THIS_PAYROLL
  NEXT_PAYROLL
  INSTALLMENT
  DIRECT_PAYMENT
  OUTSIDE_PAYROLL
}
enum EmployeeFinancialItemStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  APPLIED_TO_PAYROLL
  PAID
  SETTLED
  REJECTED
  CANCELLED
}

model EmployeeFinancialItem {
  id              String                         @id @default(cuid())
  tenantId        String
  employeeId      String
  type            EmployeeFinancialItemType
  title           String
  amount          Decimal                        @db.Decimal(18,2)
  description     String?
  createdAt       DateTime                       @default(now())
  effectiveDate   DateTime
  applyMethod     EmployeeFinancialApplyMethod
  status          EmployeeFinancialItemStatus    @default(DRAFT)
  sourceModule    String
  referenceId     String?
  createdById     String?
  approvedById    String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?
  payrollPeriod   String?
  payrollReferenceId String?
  appliedAmount   Decimal? @db.Decimal(18,2)
  payrollAppliedAt DateTime?
  paymentDate     DateTime?
  paymentAmount   Decimal? @db.Decimal(18,2)
  paymentReference String?
  paidById        String?
  settledAt       DateTime?
  tenant          Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee        Employee                       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  @@index([tenantId, employeeId, effectiveDate])
  @@index([tenantId, status])
}

enum EmployeeAssessmentType {
  HUMAN
  SYSTEM_ANALYSIS
  PERIODIC
  EVENT_BASED
  RECRUITMENT
}

enum EmployeeAssessmentPeriodType {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  EVENT_BASED
}

enum EmployeeAssessmentStatus {
  DRAFT
  IN_PROGRESS
  WAITING_APPROVAL
  FINALIZED
  ARCHIVED
}

enum EmployeeAssessmentCriterionSource {
  JOB_PROFILE
  ORGANIZATION
  MANUAL
}

enum EmployeeAssessmentActionType {
  TRAINING
  DEVELOPMENT_PLAN
  IMPROVEMENT_ACTION
  PROMOTION_PROPOSAL
  REWARD_PROPOSAL
}

enum EmployeeAssessmentActionStatus {
  OPEN
  ACCEPTED
  REJECTED
  COMPLETED
}

model EmployeeAssessment {
  id                         String                         @id @default(cuid())
  tenantId                   String
  employeeId                 String
  title                      String
  type                       EmployeeAssessmentType         @default(HUMAN)
  periodType                 EmployeeAssessmentPeriodType
  periodLabel                String?
  assessmentDate             DateTime                       @default(now())
  status                     EmployeeAssessmentStatus       @default(DRAFT)
  reviewerUserId             String?
  reviewerRole               String?
  sourceModule               String                         @default("assessment_center")
  sourceRecordId             String?
  sourceLabel                String?
  jobProfileSnapshot         Json                           @default("{}")
  positionSnapshot           Json                           @default("{}")
  performanceLevel           String?
  totalScore                 Decimal?                       @db.Decimal(7, 2)
  managerNotes               String?
  hrRecommendation           String?
  nonRenewalRecommendation   String?
  complaintData              String?
  finalizedAt                DateTime?
  createdById                String?
  updatedById                String?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  tenant                     Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee                   Employee                       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  criteria                   EmployeeAssessmentCriterion[]
  actions                    EmployeeAssessmentAction[]
  auditLogs                  EmployeeAssessmentAuditLog[]
  @@index([tenantId, employeeId, assessmentDate])
  @@index([tenantId, status])
}

model EmployeeAssessmentCriterion {
  id             String                            @id @default(cuid())
  assessmentId   String
  title          String
  description    String?
  source         EmployeeAssessmentCriterionSource
  sourceRecordId String?
  weight         Int                               @default(1)
  maxScore       Int                               @default(100)
  snapshot       Json                              @default("{}")
  assessment     EmployeeAssessment                @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  score          EmployeeAssessmentScore?
  @@index([assessmentId])
}

model EmployeeAssessmentScore {
  id          String                      @id @default(cuid())
  criterionId String                      @unique
  score       Decimal                     @db.Decimal(7, 2)
  evidence    String
  note        String?
  criterion   EmployeeAssessmentCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
}

model EmployeeAssessmentAction {
  id           String                         @id @default(cuid())
  assessmentId String
  type         EmployeeAssessmentActionType
  title        String
  description  String?
  status       EmployeeAssessmentActionStatus @default(OPEN)
  dueDate      DateTime?
  createdById  String?
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt
  assessment   EmployeeAssessment              @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  @@index([assessmentId, status])
}

model EmployeeAssessmentAuditLog {
  id           String           @id @default(cuid())
  tenantId     String
  employeeId   String
  assessmentId String
  action       String
  actorUserId  String?
  actorRole    String?
  oldValue     Json?
  newValue     Json?
  reason       String?
  createdAt    DateTime         @default(now())
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assessment   EmployeeAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  @@index([tenantId, employeeId, createdAt])
  @@index([tenantId, assessmentId, createdAt])
}

model EmployeeImportJob {
  id               String                  @id @default(cuid())
  tenantId         String
  type             EmployeeImportJobType
  fileName         String
  status           EmployeeImportJobStatus @default(queued)
  totalCount       Int                     @default(0)
  processedCount   Int                     @default(0)
  createdCount     Int                     @default(0)
  existingCount    Int                     @default(0)
  duplicateCount   Int                     @default(0)
  invalidCount     Int                     @default(0)
  failedCount      Int                     @default(0)
  mockInvitedCount Int                     @default(0)
  createdById      String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rows             EmployeeImportJobRow[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model EmployeeImportJobRow {
  id                   String                                @id @default(cuid())
  jobId                String
  rowNumber            Int
  firstName            String
  lastName             String
  email                String?
  mobile               String?
  employeeId           String?
  status               EmployeeImportJobRowStatus
  message              String?
  mockInvitationStatus EmployeeImportJobMockInvitationStatus @default(none)
  invitationChannel    EmployeeImportJobInvitationChannel?
  processedAt          DateTime?
  createdAt            DateTime                              @default(now())
  updatedAt            DateTime                              @updatedAt
  job                  EmployeeImportJob                     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, rowNumber])
}

model EmployeeContract {
  id               String                        @id
  tenantId         String?
  employeeId       String
  status           EmployeeContractStatus        @default(draft)
  isCurrent        Boolean                       @default(false)
  startDate        String?
  endDate          String?
  contractNumber   String?
  templateId       String?
  data             Json                          @default("{}")
  finalizedAt      DateTime?
  version          Int                           @default(1)
  parentContractId String?
  operationType    EmployeeContractOperationType @default(CREATE_CONTRACT)
  effectiveDate    String?
  reason           String?
  attachmentUrl    String?
  createdById      String?
  submittedAt      DateTime?
  approvedById     String?
  approvedAt       DateTime?
  appliedAt        DateTime?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  tenant           Tenant?                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee         Employee                      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvals        EmployeeContractApproval[]
  auditLogs        EmployeeContractAuditLog[]

  @@unique([tenantId, employeeId, version])
  @@index([tenantId, employeeId])
  @@index([tenantId, employeeId, isCurrent])
  @@index([employeeId, status])
  @@index([tenantId, employeeId, effectiveDate])
}

model EmployeeContractApproval {
  id          String                         @id @default(cuid())
  tenantId    String
  contractId  String
  requesterId String?
  approverId  String?
  status      EmployeeContractApprovalStatus @default(PENDING)
  reason      String
  reviewNote  String?
  requestedAt DateTime                       @default(now())
  reviewedAt  DateTime?
  contract    EmployeeContract               @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@index([tenantId, contractId, requestedAt])
  @@index([tenantId, status])
}

model EmployeeContractAuditLog {
  id             String           @id @default(cuid())
  tenantId       String
  contractId     String
  employeeId     String
  operationType  String
  oldValue       Json?
  newValue       Json?
  actorUserId    String?
  actorRole      String?
  reason         String
  approvalStatus String?
  effectiveDate  String?
  createdAt      DateTime         @default(now())
  contract       EmployeeContract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@index([tenantId, contractId, createdAt])
  @@index([tenantId, employeeId, createdAt])
}

model EmployeeAuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  action      String
  fieldKey    String?
  oldValue    String?
  newValue    String?
  actorUserId String?
  actorRole   String?
  source      String   @default("panel")
  otpVerified Boolean  @default(false)
  reason      String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId, createdAt])
  @@index([employeeId, createdAt])
}

model OffboardingApprovalStep {
  id            String   @id @default(cuid())
  tenantId      String
  offboardingId String
  stepType      String
  sequence      Int
  approverId    String?
  status        String   @default("PENDING")
  comment       String?
  rejectReason  String?
  createdAt     DateTime @default(now())
  completedAt   DateTime?
  offboarding   EmployeeTerminationIntent @relation(fields: [offboardingId], references: [id], onDelete: Cascade)

  @@unique([offboardingId, stepType])
  @@index([tenantId, offboardingId, sequence])
  @@index([tenantId, approverId, status])
}

model EmployeeTerminationIntent {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  initiatedBy String?
  status      String   @default("DRAFT")
  reason      String?
  source      String   @default("employee_detail")
  terminationType String?
  description String?
  announcementDate String?
  processStartDate DateTime?
  proposedLastWorkingDay String?
  effectiveTerminationDate String?
  accessDisableDate DateTime?
  settlementCompletionDate DateTime?
  archiveDate DateTime?
  immediateAccessRevocation Boolean @default(false)
  nextAction String?
  stageOwner String?
  settlementStatus String @default("PENDING")
  assetStatus String @default("NOT_APPLICABLE")
  accessStatus String @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  approvalSteps OffboardingApprovalStep[]

  @@index([tenantId, employeeId, status])
  @@index([employeeId, createdAt])
}

model EmployeeSkill {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  title       String
  category    String
  level       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([tenantId, employeeId, title, category])
  @@index([tenantId, employeeId, isActive])
}

model EmployeeInterest {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  category    String
  title       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([tenantId, employeeId, title, category])
  @@index([tenantId, employeeId, isActive])
}

model EmployeeWorkPreference {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String   @unique
  values     Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId])
}

model EmployeeHealthProfile {
  id                           String    @id @default(cuid())
  tenantId                     String
  employeeId                   String    @unique
  physicalHealthNotes          String?
  mobilityLimitations          String?
  specialMedicalConsiderations String?
  workplaceAccommodationNeeds  String?
  mentalHealthNotes            String?
  lastReviewedAt               DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  tenant                       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee                     Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId])
}

model EmployeeEmergencyContact {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  name       String
  relation   String
  mobile     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId])
}

model EmployeeProfileApproval {
  id          String                        @id @default(cuid())
  tenantId    String
  employeeId  String
  categoryKey String
  status      EmployeeProfileApprovalStatus @default(NOT_STARTED)
  submittedBy String?
  submittedAt DateTime?
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  tenant      Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee                      @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([tenantId, employeeId, categoryKey])
  @@index([tenantId, employeeId, status])
}

model EmployeeChangeRequest {
  id             String                      @id @default(cuid())
  tenantId       String
  employeeId     String
  fieldKey       String
  category       String
  operationType  String
  status         EmployeeChangeRequestStatus @default(DRAFT)
  oldValue       Json?
  newValue       Json
  reasonCode     String
  reasonText     String?
  attachmentUrl  String?
  effectiveDate  String?
  otpStatus      String                      @default("NOT_REQUIRED")
  otpVerifiedAt  DateTime?
  payrollImpact  Boolean                     @default(false)
  contractImpact Boolean                     @default(false)
  requestedBy    String?
  requestedAt    DateTime                    @default(now())
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewNote     String?
  appliedBy      String?
  appliedAt      DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  tenant         Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee                    @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId, status])
  @@index([tenantId, fieldKey, status])
}

model EmployeeOrganizationUnit {
  id                 String                       @id @default(cuid())
  employeeId         String
  organizationUnitId String
  positionId         String?
  startDate          String?
  endDate            String?
  status             OrganizationAssignmentStatus @default(ACTIVE)
  employee           Employee                     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organizationUnit   OrganizationUnit             @relation(fields: [organizationUnitId], references: [id], onDelete: Cascade)
  position           Position?                    @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@unique([employeeId, organizationUnitId])
  @@index([organizationUnitId, status])
  @@index([positionId, status])
}

model CompanyLoan {
  id              String            @id @default(cuid())
  tenantId        String?
  title           String
  guarantorCount  Int
  minAmount       Decimal           @db.Decimal(18, 2)
  maxAmount       Decimal           @db.Decimal(18, 2)
  minInstallments Int
  maxInstallments Int
  feeRate         Decimal           @db.Decimal(7, 3)
  interestRate    Decimal           @db.Decimal(7, 3)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenant          Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests        EmployeeRequest[]

  @@index([tenantId])
  @@index([tenantId, isActive])
}

model EmployeeRequest {
  id                        String                        @id @default(cuid())
  tenantId                  String?
  employeeId                String
  requestType               EmployeeRequestType
  status                    EmployeeRequestStatus         @default(pending)
  submissionMode            EmployeeRequestSubmissionMode @default(pending)
  startDate                 String?
  endDate                   String?
  startTime                 String?
  endTime                   String?
  dateTime                  String?
  rangeType                 EmployeeRequestRangeType?
  attendanceActionType      AttendanceActionType?
  amount                    Decimal?                      @db.Decimal(18, 2)
  loanId                    String?
  installments              Int?
  reasonId                  String?
  description               String?
  calculatedDurationMinutes Int?
  calculationMeta           Json                          @default("{}")
  createdBy                 String?
  approvedBy                String?
  approvedAt                DateTime?
  rejectedBy                String?
  rejectedAt                DateTime?
  canceledAt                DateTime?
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  tenant                    Tenant?                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee                  Employee                      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reason                    RequestReason?                @relation(fields: [reasonId], references: [id], onDelete: SetNull)
  loan                      CompanyLoan?                  @relation(fields: [loanId], references: [id], onDelete: SetNull)

  @@index([tenantId, employeeId])
  @@index([tenantId, requestType])
  @@index([tenantId, status])
  @@index([reasonId])
  @@index([loanId])
}

model Attachment {
  id               String            @id @default(cuid())
  tenantId         String?
  ownerType        String
  ownerId          String
  categoryId       String?
  categoryName     String
  titleId          String?
  title            String
  fileUrl          String            @db.Text
  fileName         String
  fileType         String?
  fileSize         Int?
  issuedAt         String?
  description      String?
  uploadedAt       DateTime          @default(now())
  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeDocument EmployeeDocument?

  @@index([tenantId, ownerType, ownerId])
  @@index([ownerType, ownerId])
}

model EmployeeDocument {
  id               String                       @id @default(cuid())
  tenantId         String
  employeeId       String
  attachmentId     String?                      @unique
  contentHash      String?
  title            String
  documentType     String
  category         String
  subCategory      String?
  description      String?
  documentDate     String
  documentNumber   String?
  tags             Json                         @default("[]")
  accessLevel      EmployeeDocumentAccessLevel
  sourceType       EmployeeDocumentSourceType
  sourceModule     EmployeeDocumentSourceModule
  sourceRecordId   String?
  sourceHref       String?
  status           EmployeeDocumentStatus       @default(FINAL)
  versionNumber    Int                          @default(1)
  parentDocumentId String?
  versionReason    String?
  isCurrentVersion Boolean                      @default(true)
  expiresAt        String?
  createdBy        String?
  archivedAt       DateTime?
  archivedBy       String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  tenant           Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee         Employee                     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  attachment       Attachment?                  @relation(fields: [attachmentId], references: [id], onDelete: Restrict)
  parentDocument   EmployeeDocument?            @relation("EmployeeDocumentVersions", fields: [parentDocumentId], references: [id], onDelete: Restrict)
  versions         EmployeeDocument[]           @relation("EmployeeDocumentVersions")
  auditLogs        EmployeeDocumentAuditLog[]

  @@unique([tenantId, sourceModule, sourceRecordId])
  @@unique([tenantId, employeeId, parentDocumentId, versionNumber])
  @@index([tenantId, employeeId, isCurrentVersion, status])
  @@index([tenantId, employeeId, category, documentDate])
  @@index([tenantId, employeeId, sourceModule])
  @@index([tenantId, employeeId, contentHash])
}

model EmployeeDocumentAuditLog {
  id            String           @id @default(cuid())
  tenantId      String
  employeeId    String
  documentId    String
  versionNumber Int
  action        String
  actorUserId   String?
  actorRole     String?
  metadata      Json             @default("{}")
  createdAt     DateTime         @default(now())
  document      EmployeeDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId, createdAt])
  @@index([tenantId, documentId, createdAt])
}

model WorkGroup {
  id              String                    @id @default(cuid())
  tenantId        String?
  title           String
  normalizedTitle String                    @default("")
  description     String?
  tags            Json                      @default("[]")
  locationId      String?
  policyId        String?
  status          WorkGroupLifecycleStatus  @default(ACTIVE)
  disabledAt      DateTime?
  disabledReason  String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  tenant          Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location        Location?                 @relation(fields: [locationId], references: [id], onDelete: SetNull)
  policy          WorkPolicy?               @relation(fields: [policyId], references: [id], onDelete: SetNull)
  members         WorkGroupMember[]
  contextHistory  WorkGroupContextHistory[]
  auditLogs       WorkGroupAuditLog[]

  @@unique([tenantId, normalizedTitle])
  @@index([tenantId, status])
}

model WorkGroupMember {
  id            String                    @id @default(cuid())
  workGroupId   String
  employeeId    String
  accessLevel   WorkGroupAccessLevel      @default(employee)
  joinedAt      DateTime                  @default(now())
  leftAt        DateTime?
  effectiveDate DateTime                  @default(now())
  status        WorkGroupMembershipStatus @default(ACTIVE)
  reason        String?
  createdBy     String?
  isCurrent     Boolean                   @default(true)
  workGroup     WorkGroup                 @relation(fields: [workGroupId], references: [id], onDelete: Restrict)
  employee      Employee                  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([workGroupId, isCurrent])
  @@index([employeeId, isCurrent])
  @@index([workGroupId, employeeId])
  @@index([employeeId, effectiveDate])
}

model WorkGroupContextHistory {
  id            String               @id @default(cuid())
  tenantId      String
  workGroupId   String
  type          WorkGroupContextType
  previousId    String?
  nextId        String?
  effectiveDate DateTime
  reason        String
  createdBy     String
  createdAt     DateTime             @default(now())
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workGroup     WorkGroup            @relation(fields: [workGroupId], references: [id], onDelete: Restrict)

  @@index([tenantId, workGroupId, type, effectiveDate])
}

model WorkGroupAuditLog {
  id            String    @id @default(cuid())
  tenantId      String
  workGroupId   String
  action        String
  entity        String    @default("WorkGroup")
  entityId      String
  actorUserId   String
  actorRole     String
  before        Json?
  after         Json?
  reason        String?
  effectiveDate DateTime?
  createdAt     DateTime  @default(now())
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workGroup     WorkGroup @relation(fields: [workGroupId], references: [id], onDelete: Restrict)

  @@index([tenantId, workGroupId, createdAt])
  @@index([entity, entityId])
}

model DraftTemplate {
  id          String                @id @default(cuid())
  tenantId    String?
  title       String
  description String?
  category    DraftTemplateCategory @default(hr)
  body        String
  version     Int                   @default(1)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  tenant      Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ClientStorageState {
  id         String   @id @default(cuid())
  scope      String
  tenantId   String?
  storageKey String
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([scope, storageKey])
  @@index([tenantId])
  @@index([scope])
}

model TenantBusinessProfileSettings {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  profilePayload Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model TenantSetupReminderState {
  id             String    @id @default(cuid())
  tenantId       String
  userId         String
  reminderKey    String
  dismissedUntil DateTime?
  dismissedCount Int       @default(0)
  lastShownAt    DateTime?
  lastActionAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, reminderKey])
  @@index([tenantId, userId])
  @@index([tenantId, reminderKey])
}
