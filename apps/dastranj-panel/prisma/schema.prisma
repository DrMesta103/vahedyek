generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model AppUser {
  id           String                 @id @default(cuid())
  email        String?                @unique
  mobile       String?                @unique
  firstName    String
  lastName     String
  fullName     String
  passwordHash String
  passwordSalt String
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  memberships  UserTenantMembership[]
}

model Tenant {
  id                  String                 @id @default(cuid())
  slug                String                 @unique
  name                String
  brandCode           String                 @default("DS")
  packageKey          String                 @default("starter")
  billingCycle        String                 @default("monthly")
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  memberships         UserTenantMembership[]
  roles               TenantRole[]
  businessProfiles    BusinessProfile[]
  locations           Location[]
  calendars           Calendar[]
  policies            WorkPolicy[]
  employees           Employee[]
  workGroups          WorkGroup[]
  organizationUnits   OrganizationUnit[]
  requestReasons      RequestReason[]
  shiftTemplates      ShiftTemplate[]
  draftTemplates      DraftTemplate[]
  clientStorageStates ClientStorageState[]
  employeeRequests    EmployeeRequest[]
  companyLoans        CompanyLoan[]
  attachments         Attachment[]
}

model UserTenantMembership {
  id        String                     @id @default(cuid())
  userId    String
  tenantId  String
  role      String                     @default("member")
  createdAt DateTime                   @default(now())
  user      AppUser                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles     UserTenantMembershipRole[]

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

model TenantRole {
  id          String                     @id @default(cuid())
  tenantId    String
  key         String
  label       String
  system      Boolean                    @default(false)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships UserTenantMembershipRole[]
  permissions TenantRolePermission[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model TenantRolePermission {
  id            String     @id @default(cuid())
  roleId        String
  permissionKey String
  createdAt     DateTime   @default(now())
  role          TenantRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionKey])
  @@index([roleId])
}

model UserTenantMembershipRole {
  id           String               @id @default(cuid())
  membershipId String
  roleId       String
  createdAt    DateTime             @default(now())
  membership   UserTenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         TenantRole           @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@index([membershipId])
  @@index([roleId])
}

// ─── HR Enums ─────────────────────────────────────────────────────────────────

enum QuickSetupStatus {
  pending
  in_progress
  completed
}

enum ShiftTemplateType {
  fixed
  floating_day_start
  floating_absolute
  split
  rotate
}

enum RequestReasonCategory {
  daily_leave
  hourly_leave
  reward_leave
  unpaid_leave
  sick_leave
  overtime
  attendance
  remote_work
  mission
  salary_advance
  loan
}

enum EmployeeRequestType {
  daily_leave
  hourly_leave
  reward_leave
  unpaid_leave
  sick_leave
  overtime
  attendance
  remote_work
  mission
  salary_advance
  loan
}

enum EmployeeRequestStatus {
  pending
  approved
  rejected
  canceled
}

enum EmployeeRequestSubmissionMode {
  approved
  pending
}

enum EmployeeRequestRangeType {
  full_day
  multi_day
  hourly
  range
  point
}

enum AttendanceActionType {
  check_in
  check_out
  correction
}

enum MaritalStatus {
  single
  married
  divorced
}

enum CalendarStatus {
  active
  inactive
}

enum DraftTemplateCategory {
  payroll
  attendance
  hr
}

enum WorkGroupAccessLevel {
  employee
  lead
  manager
}

// ─── HR Models ────────────────────────────────────────────────────────────────

model BusinessProfile {
  id                    String           @id @default(cuid())
  tenantId              String?
  brandName             String
  legalName             String?
  contactEmail          String?
  phone                 String?
  address               String?
  payrollPackageEnabled Boolean          @default(false)
  quickSetupStatus      QuickSetupStatus @default(pending)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  tenant                Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Location {
  id          String      @id @default(cuid())
  tenantId    String?
  title       String
  address     String
  radius      Int
  latitude    Decimal?    @db.Decimal(10, 6)
  longitude   Decimal?    @db.Decimal(10, 6)
  description String?
  isPrimaryOnboarding Boolean @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tenant      Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workGroups  WorkGroup[]

  @@index([tenantId, isPrimaryOnboarding])
}

model OrganizationUnit {
  id          String                     @id @default(cuid())
  tenantId    String?
  title       String
  description String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  tenant      Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees   EmployeeOrganizationUnit[]

  @@index([tenantId])
}

model RequestReason {
  id           String                @id @default(cuid())
  tenantId     String?
  title        String
  description  String?
  category     RequestReasonCategory
  isActive     Boolean               @default(true)
  displayOrder Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  tenant       Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeRequests EmployeeRequest[]

  @@index([tenantId])
}

model ShiftTemplate {
  id          String            @id @default(cuid())
  tenantId    String?
  title       String
  description String?
  type        ShiftTemplateType
  weekDays    Json              @default("[]")
  config      Json              @default("{}")
  breaks      Json              @default("[]")
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tenant      Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Calendar {
  id             String         @id @default(cuid())
  tenantId       String?
  title          String
  description    String?
  yearLabel      String
  startDate      String
  endDate        String
  weekends       Json           @default("[]")
  singleHolidays Json           @default("[]")
  status         CalendarStatus @default(active)
  shiftTitle     String         @default("")
  shiftTypeLabel String         @default("")
  shiftConfig    Json           @default("{}")
  holidayCount   Int            @default(0)
  totalShiftDays Int            @default(0)
  totalEventDays Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenant         Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policies       WorkPolicy[]
}

model WorkPolicy {
  id            String      @id @default(cuid())
  tenantId      String?
  title         String
  description   String?
  calendarId    String?
  sectionValues Json        @default("{}")
  employeeCount Int         @default(0)
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  tenant        Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  calendar      Calendar?   @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  workGroups    WorkGroup[]
}

model Employee {
  id                   String                     @id @default(cuid())
  tenantId             String?
  firstName            String
  lastName             String
  nationalId           String?
  mobile1              String?
  mobile2              String?
  email                String?
  personnelCode        String?
  maritalStatus        MaritalStatus              @default(single)
  childrenCount        Int                        @default(0)
  canEditIdentityPhoto Boolean                    @default(false)
  isActive             Boolean                    @default(true)
  avatarUrl            String?
  identityPhotoUrl     String?
  bankAccounts         Json                       @default("[]")
  guarantees           Json                       @default("[]")
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  tenant               Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organizationUnits    EmployeeOrganizationUnit[]
  workGroupMemberships WorkGroupMember[]
  requests             EmployeeRequest[]
}

model EmployeeOrganizationUnit {
  id                 String           @id @default(cuid())
  employeeId         String
  organizationUnitId String
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organizationUnit   OrganizationUnit @relation(fields: [organizationUnitId], references: [id], onDelete: Cascade)

  @@unique([employeeId, organizationUnitId])
}

model CompanyLoan {
  id              String            @id @default(cuid())
  tenantId        String?
  title           String
  guarantorCount  Int
  minAmount       Decimal           @db.Decimal(18, 2)
  maxAmount       Decimal           @db.Decimal(18, 2)
  minInstallments Int
  maxInstallments Int
  feeRate         Decimal           @db.Decimal(7, 3)
  interestRate    Decimal           @db.Decimal(7, 3)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenant          Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests        EmployeeRequest[]

  @@index([tenantId])
  @@index([tenantId, isActive])
}

model EmployeeRequest {
  id                        String                        @id @default(cuid())
  tenantId                  String?
  employeeId                String
  requestType               EmployeeRequestType
  status                    EmployeeRequestStatus         @default(pending)
  submissionMode            EmployeeRequestSubmissionMode  @default(pending)
  startDate                 String?
  endDate                   String?
  startTime                 String?
  endTime                   String?
  dateTime                  String?
  rangeType                 EmployeeRequestRangeType?
  attendanceActionType      AttendanceActionType?
  amount                    Decimal?                      @db.Decimal(18, 2)
  loanId                    String?
  installments              Int?
  reasonId                  String?
  description               String?
  calculatedDurationMinutes Int?
  calculationMeta           Json                          @default("{}")
  createdBy                 String?
  approvedBy                String?
  approvedAt                DateTime?
  rejectedBy                String?
  rejectedAt                DateTime?
  canceledAt                DateTime?
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  tenant                    Tenant?                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee                  Employee                      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reason                    RequestReason?                @relation(fields: [reasonId], references: [id], onDelete: SetNull)
  loan                      CompanyLoan?                  @relation(fields: [loanId], references: [id], onDelete: SetNull)

  @@index([tenantId, employeeId])
  @@index([tenantId, requestType])
  @@index([tenantId, status])
  @@index([reasonId])
  @@index([loanId])
}

model Attachment {
  id           String   @id @default(cuid())
  tenantId     String?
  ownerType    String
  ownerId      String
  categoryId   String?
  categoryName String
  titleId      String?
  title        String
  fileUrl      String   @db.Text
  fileName     String
  fileType     String?
  fileSize     Int?
  issuedAt     String?
  description  String?
  uploadedAt   DateTime @default(now())
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, ownerType, ownerId])
  @@index([ownerType, ownerId])
}

model WorkGroup {
  id          String            @id @default(cuid())
  tenantId    String?
  title       String
  description String?
  tags        Json              @default("[]")
  locationId  String?
  policyId    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tenant      Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location    Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  policy      WorkPolicy?       @relation(fields: [policyId], references: [id], onDelete: SetNull)
  members     WorkGroupMember[]
}

model WorkGroupMember {
  id          String               @id @default(cuid())
  workGroupId String
  employeeId  String
  accessLevel WorkGroupAccessLevel @default(employee)
  joinedAt    DateTime             @default(now())
  leftAt      DateTime?
  isCurrent   Boolean              @default(true)
  workGroup   WorkGroup            @relation(fields: [workGroupId], references: [id], onDelete: Cascade)
  employee    Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([workGroupId, isCurrent])
  @@index([employeeId, isCurrent])
  @@index([workGroupId, employeeId])
}

model DraftTemplate {
  id          String                @id @default(cuid())
  tenantId    String?
  title       String
  description String?
  category    DraftTemplateCategory @default(hr)
  body        String
  version     Int                   @default(1)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  tenant      Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ClientStorageState {
  id         String   @id @default(cuid())
  scope      String
  tenantId   String?
  storageKey String
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([scope, storageKey])
  @@index([tenantId])
  @@index([scope])
}
