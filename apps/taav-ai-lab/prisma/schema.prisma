generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id           String                 @id @default(cuid())
  email        String?                @unique
  mobile       String?                @unique
  firstName    String
  lastName     String
  fullName     String
  passwordHash String
  passwordSalt String
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  memberships  UserTenantMembership[]
}

model Tenant {
  id            String                 @id @default(cuid())
  slug          String                 @unique
  name          String
  brandCode     String?
  packageKey    String?
  billingCycle  String?
  logoUrl       String
  tokenLimit    Int
  usedTokens    Int                    @default(0)
  ocrTestsCount Int                    @default(0)
  lastActivity  DateTime?
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  memberships   UserTenantMembership[]
  products      TenantProduct[]
  ocrJobs       OcrJob[]
  taaviaBrands  TaaviaBrand[]
  conversations TaaviaConversation[]
}

model UserTenantMembership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("owner")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

model TenantProduct {
  id         String   @id @default(cuid())
  tenantId   String
  productKey String
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productKey])
  @@index([tenantId])
}

model OcrJob {
  id             String    @id @default(cuid())
  tenantId       String
  sourceType     String
  sourceName     String
  sourceLabel    String
  fileType       String
  fileSize       Int?
  sampleId       String?
  templateId     String?
  templateLabel  String?
  scenario       String?
  status         String
  progress       Int
  confidence     Int
  pageCount      Int
  tokensUsed     Int
  summary        String
  previewText    String    @db.Text
  templateSchema Json?
  resultJson     Json?
  extractedJson  Json      @default("{}")
  extractedFields Json     @default("[]")
  warnings       Json      @default("[]")
  error          String?
  terminalStatus String    @default("completed")
  createdAt      DateTime  @default(now())
  startedAt      DateTime
  readyAt        DateTime
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model TaaviaBrand {
  id              String               @id @default(cuid())
  tenantId        String
  name            String
  createdByUserId String
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations   TaaviaConversation[]

  @@index([tenantId])
}

model TaaviaConversation {
  id              String          @id @default(cuid())
  tenantId        String
  brandId         String
  type            String          @default("admin_agent")
  state           String          @default("active")
  createdByUserId String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  brand           TaaviaBrand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages        TaaviaMessage[]

  @@unique([brandId, type])
  @@index([tenantId])
}

model TaaviaMessage {
  id             String             @id @default(cuid())
  conversationId String
  role           String
  content        String             @db.Text
  status         String             @default("completed")
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  conversation   TaaviaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model PlatformUsdRate {
  id         String   @id @default("global")
  usdToToman Int
  updatedAt  DateTime @updatedAt
}

model AiPricingModel {
  id                   String   @id
  provider             String
  providerLabel        String
  name                 String
  category             String
  pricePer100TokensUsd Decimal  @db.Decimal(10, 4)
  isActive             Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model AiProviderApiKey {
  id        String   @id @default(cuid())
  provider  String
  label     String
  maskedKey String
  fullKey   String
  modelIds  String[]
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model PlatformAdminCredential {
  id           String   @id @default("settings-admin")
  username     String
  passwordHash String
  passwordSalt String
  updatedAt    DateTime @updatedAt
}
