{
  "name": "vahedyek-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:vahedyek": "npm --workspace @apps/vahedyek-panel run dev",
    "dev:dastranj": "npm --workspace @apps/dastranj-panel run dev",
    "build": "npm run build:vahedyek",
    "build:all": "npm run build:vahedyek && npm run build:dastranj",
    "build:vahedyek": "npm --workspace @apps/vahedyek-panel run build",
    "build:dastranj": "npm --workspace @apps/dastranj-panel run build",
    "start": "npm run start:vahedyek",
    "start:vahedyek": "npm --workspace @apps/vahedyek-panel run start",
    "start:dastranj": "npm --workspace @apps/dastranj-panel run start",
    "prisma:generate:vahedyek": "npm --workspace @apps/vahedyek-panel run prisma:generate",
    "prisma:migrate:vahedyek": "npm --workspace @apps/vahedyek-panel run prisma:migrate",
    "prisma:deploy:vahedyek": "npm --workspace @apps/vahedyek-panel run prisma:deploy",
    "db:seed:vahedyek": "npm --workspace @apps/vahedyek-panel run db:seed",
    "test:financial": "npm --workspace @apps/vahedyek-panel run test:financial",
    "test:subject": "npm --workspace @apps/vahedyek-panel run test:subject"
  },
  "dependencies": {
    "@locator/runtime": "^0.5.1"
  }
}
